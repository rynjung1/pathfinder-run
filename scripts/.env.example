# Copy this file to .env (gitignored) and fill in real values.
# route_api.py refuses to start without PATHFINDER_API_KEY set -- see its
# module docstring / require_api_key for why there's no unauthenticated
# fallback mode, in local dev or otherwise.

# A shared secret checked via the X-API-Key header on every endpoint
# except /health. Generate a real one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
PATHFINDER_API_KEY=replace-with-a-real-generated-secret

# Only used by scripts/serve.py (the production entrypoint, waitress) --
# route_api.py's own dev entrypoint (python3 route_api.py) ignores these
# and keeps binding 0.0.0.0 for iOS Simulator/physical-device testing.
# PATHFINDER_HOST=127.0.0.1
# PATHFINDER_PORT=5001
# PATHFINDER_THREADS=4
