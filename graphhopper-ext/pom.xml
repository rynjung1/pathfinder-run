<?xml version="1.0" encoding="UTF-8"?>
<!--
  Pathfinder Run: Java extension for GraphHopper, restoring greenness
  scoring at Ontario scale via a static per-way encoded value instead of
  the old live per-query custom_areas lookup (removed; see
  ../graphhopper/pathfinder_foot.json's comment for why).

  Deliberately a thin standalone import tool, not a modified web server:
  confirmed via decompiling graphhopper-web.jar that GraphHopper.load()
  (which is all the production server ever does; see
  ../deploy/README.md's "build off-box, rsync the graph-cache" plan)
  reconstructs its EncodingManager via EncodingManager.fromProperties(...),
  entirely independent of the ImportRegistry that only matters at import
  time. So the stock, unmodified graphhopper-web.jar can serve whatever
  this tool produces: no Dropwizard/Jersey code needed here at all,
  which is most of what made the original "multi-day" estimate for this
  work as large as it was.

  graphhopper-core:9.1 as `provided` scope: compiling against GraphHopper's
  classes needs them on the compile classpath, but they're already present
  at runtime via the real graphhopper-web.jar sitting next to this one on
  the classpath (see run-import.sh); provided scope keeps this jar small
  and avoids bundling a second copy of a 45MB dependency tree.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>run.pathfinder</groupId>
  <artifactId>graphhopper-ext</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <graphhopper.version>9.1</graphhopper.version>
    <!-- The exact version bundled inside the real graphhopper-web.jar
         this project actually runs against (confirmed directly by
         inspecting its META-INF/maven/.../pom.properties, not guessed;
         see the jackson-databind/jackson-dataformat-yaml comments below
         for why this has to be exact, not just "recent enough"). -->
    <jackson.version>2.13.5</jackson.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.graphhopper</groupId>
      <artifactId>graphhopper-core</artifactId>
      <version>${graphhopper.version}</version>
      <scope>provided</scope>
    </dependency>
    <!-- Jackson for reading the precomputed way-id JSON
         (data/greenspace_way_ids*.json): already a transitive dependency
         of graphhopper-core, pinned explicitly here only so the version is
         intentional, not incidental.

         Pinned to graphhopper-web.jar's own bundled version (2.13.5),
         not the latest release; found a real bug from getting this
         wrong: this used to say 2.17.1, newer than jackson-core's own
         2.13.5 (pulled in transitively via graphhopper-core, unaffected
         by this file since there was never an explicit jackson-core
         dependency here at all). `mvn test`/`mvn package` resolve
         dependencies purely from these declarations, independent of
         whatever's actually inside graphhopper-web.jar, and a mixed
         2.17.1-databind/2.13.5-core classpath is genuinely broken, not
         just untidy: PathfinderImporterTest (added alongside this fix)
         hit a real `NoSuchMethodError:
         YAMLParser.createChildObjectContext` from it the moment a test
         finally exercised YAML parsing, something no earlier test ever
         did. The REAL production classpath (java -cp
         graphhopper-web.jar:graphhopper-ext-1.0.0.jar, see run-import.sh)
         was never actually broken by this; provided-scope dependencies
         are never bundled into graphhopper-ext's own jar, so production
         was always using graphhopper-web.jar's own internally-consistent
         2.13.5 set for everything Jackson-related regardless of what
         this file said; matching that version here now makes Maven's
         compile/test classpath a true match of the real runtime
         classpath, not just "some jar labeled jackson-databind." -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>${jackson.version}</version>
      <scope>provided</scope>
    </dependency>
    <!-- For parsing config-ontario.yml directly (the same real config file
         production uses, not a hand-duplicated copy of its settings):
         provided scope, same reasoning; already on the runtime classpath
         via graphhopper-web.jar's own bundled deps. Same version-pinning
         reasoning as jackson-databind above; this is the one that
         actually surfaced the mismatch (YAMLParser is defined here, not
         in jackson-databind). -->
    <dependency>
      <groupId>com.fasterxml.jackson.dataformat</groupId>
      <artifactId>jackson-dataformat-yaml</artifactId>
      <version>${jackson.version}</version>
      <scope>provided</scope>
    </dependency>
    <!-- Was zero test coverage here at all; found on a backend sweep.
         JUnit 5. Real GraphHopper types (SimpleBooleanEncodedValue,
         ReaderWay, a hand-rolled EdgeIntAccess) turned out directly
         instantiable/fakeable without a mocking library, so this pulls
         in only the test framework itself. -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.10.2</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
      </plugin>
    </plugins>
  </build>
</project>
