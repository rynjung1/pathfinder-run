# Copy to mobile/.env (gitignored, see root .gitignore) and fill in the
# real value -- must match PATHFINDER_API_KEY in scripts/.env, since it's
# authenticating against the same route_api.py. Expo inlines any
# EXPO_PUBLIC_-prefixed var from this file into the bundle at build/start
# time (built into Expo SDK 49+, no extra config needed) -- see App.js's
# API_KEY constant.
EXPO_PUBLIC_PATHFINDER_API_KEY=
