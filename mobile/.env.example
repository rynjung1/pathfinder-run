# Copy to mobile/.env (gitignored, see root .gitignore) and fill in the
# real value -- must match PATHFINDER_API_KEY in scripts/.env, since it's
# authenticating against the same route_api.py. Expo inlines any
# EXPO_PUBLIC_-prefixed var from this file into the bundle at build/start
# time (built into Expo SDK 49+, no extra config needed) -- see App.js's
# API_KEY constant.
EXPO_PUBLIC_PATHFINDER_API_KEY=

# Optional -- only needed to point this build at something other than
# http://localhost:5001 (App.js's default). Leave unset for local dev
# against a server on the same machine. For a real device on the same LAN,
# set it to http://<your dev machine's LAN IP>:5001; for a production
# build, this is where the real deployed domain goes (see
# deploy/README.md) -- set via `eas env:set` for cloud builds rather than
# here, since this file never leaves your machine.
EXPO_PUBLIC_API_BASE_URL=
